<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Ana Renkler -->
    <Color x:Key="ThemeBgColor">#1E1E1E</Color>
    <Color x:Key="ThemeFgColor">#E0E0E0</Color>
    <Color x:Key="ThemeMutedColor">#AAAAAA</Color>
    <Color x:Key="ThemeLightMutedColor">#888888</Color>
    <Color x:Key="ThemeBorderColor">#444444</Color>
    <Color x:Key="ThemeSeparatorColor">#333333</Color>

    <SolidColorBrush x:Key="ThemeBackground" Color="{StaticResource ThemeBgColor}"/>
    <SolidColorBrush x:Key="ThemeForeground" Color="{StaticResource ThemeFgColor}"/>
    <SolidColorBrush x:Key="ThemeMuted" Color="{StaticResource ThemeMutedColor}"/>
    <SolidColorBrush x:Key="ThemeLightMuted" Color="{StaticResource ThemeLightMutedColor}"/>
    <SolidColorBrush x:Key="ThemeBorder" Color="{StaticResource ThemeBorderColor}"/>
    <SolidColorBrush x:Key="ThemeSeparator" Color="{StaticResource ThemeSeparatorColor}"/>

    <!-- Kart / Blok Renkleri -->
    <Color x:Key="CardWarningColor">#2A2A2A</Color>
    <Color x:Key="CardCodeColor">#2A2A2A</Color>
    <Color x:Key="CardNameColor">#1A3A5C</Color>
    <Color x:Key="CardCausesColor">#2A2A1A</Color>
    <Color x:Key="CardSolutionColor">#1A3D1A</Color>
    <Color x:Key="CardSeverityColor">#5C1A1A</Color>
    <Color x:Key="CardLoadingColor">#2D2D2D</Color>
    <Color x:Key="CardHistoryBgColor">#252525</Color>
    <Color x:Key="CardHistoryAltColor">#2D2D2D</Color>
    <Color x:Key="CardResolvedColor">#1A3D1A</Color>

    <SolidColorBrush x:Key="CardWarning" Color="{StaticResource CardWarningColor}"/>
    <SolidColorBrush x:Key="CardCode" Color="{StaticResource CardCodeColor}"/>
    <SolidColorBrush x:Key="CardName" Color="{StaticResource CardNameColor}"/>
    <SolidColorBrush x:Key="CardCauses" Color="{StaticResource CardCausesColor}"/>
    <SolidColorBrush x:Key="CardSolution" Color="{StaticResource CardSolutionColor}"/>
    <SolidColorBrush x:Key="CardSeverity" Color="{StaticResource CardSeverityColor}"/>
    <SolidColorBrush x:Key="CardLoading" Color="{StaticResource CardLoadingColor}"/>
    <SolidColorBrush x:Key="CardHistoryBg" Color="{StaticResource CardHistoryBgColor}"/>
    <SolidColorBrush x:Key="CardHistoryAlt" Color="{StaticResource CardHistoryAltColor}"/>
    <SolidColorBrush x:Key="CardResolved" Color="{StaticResource CardResolvedColor}"/>

    <!-- Buton Renkleri -->
    <Color x:Key="PrimaryBtnColor">#1565C0</Color>
    <Color x:Key="PrimaryBtnHoverColor">#1976D2</Color>
    <Color x:Key="SuccessBtnColor">#2E7D32</Color>
    <Color x:Key="SuccessBtnHoverColor">#388E3C</Color>
    <Color x:Key="SecondaryBtnColor">#616161</Color>
    <Color x:Key="SecondaryBtnHoverColor">#757575</Color>

    <SolidColorBrush x:Key="PrimaryButtonBg" Color="{StaticResource PrimaryBtnColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBg" Color="{StaticResource PrimaryBtnHoverColor}"/>
    <SolidColorBrush x:Key="SuccessButtonBg" Color="{StaticResource SuccessBtnColor}"/>
    <SolidColorBrush x:Key="SuccessButtonHoverBg" Color="{StaticResource SuccessBtnHoverColor}"/>
    <SolidColorBrush x:Key="SecondaryButtonBg" Color="{StaticResource SecondaryBtnColor}"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBg" Color="{StaticResource SecondaryBtnHoverColor}"/>

    <!-- Koyu temada durum/uyari metni rengi -->
    <Color x:Key="WarningTextColor">#FFB74D</Color>
    <SolidColorBrush x:Key="WarningText" Color="{StaticResource WarningTextColor}"/>

    <!-- Diğer -->
    <Color x:Key="LinkColor">#64B5F6</Color>
    <Color x:Key="ResolvedTextColor">#81C784</Color>
    <Color x:Key="TitleColor">#EF5350</Color>

    <SolidColorBrush x:Key="LinkForeground" Color="{StaticResource LinkColor}"/>
    <SolidColorBrush x:Key="ResolvedText" Color="{StaticResource ResolvedTextColor}"/>
    <SolidColorBrush x:Key="TitleForeground" Color="{StaticResource TitleColor}"/>
    <SolidColorBrush x:Key="WhiteText" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="BlackText" Color="#1E1E1E"/>
</ResourceDictionary>
