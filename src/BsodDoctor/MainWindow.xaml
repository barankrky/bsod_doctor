<Window x:Class="BsodDoctor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BsodDoctor.ViewModels"
        xmlns:local="clr-namespace:BsodDoctor"
        mc:Ignorable="d"
        Title="BSOD Doctor" Height="750" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Converter'lar -->
        <local:BoolInverterConverter x:Key="BoolInverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#106EBE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SuccessButton">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#757575"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#616161"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>      <!-- Başlık -->
            <RowDefinition Height="Auto"/>      <!-- Butonlar -->
            <RowDefinition Height="2*"/>        <!-- Detay -->
            <RowDefinition Height="Auto"/>      <!-- Loading -->
            <RowDefinition Height="1*"/>        <!-- Geçmiş -->
            <RowDefinition Height="Auto"/>      <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="BSOD Doctor" FontSize="28" FontWeight="Bold" Foreground="#D32F2F"/>
            <TextBlock Text="Mavi Ekran Hatalarına Hızlı Çözüm" FontSize="13" Foreground="#666666"/>
            <Separator Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Aksiyon Butonları -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="🔍 Tüm Dump'ları Tara"
                    Command="{Binding ScanNowCommand}"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding IsAnalyzing, Converter={StaticResource BoolInverter}}"/>
            <Button Content="✅ Çözüldü İşaretle"
                    Command="{Binding MarkResolvedCommand}"
                    Style="{StaticResource SuccessButton}"
                    IsEnabled="{Binding HasResult}"/>
            <Button Content="✕ Temizle"
                    Command="{Binding ClearResultCommand}"
                    Style="{StaticResource SecondaryButton}"
                    IsEnabled="{Binding HasResult}"/>

            <Border Background="#FFF3E0" Padding="12,6" CornerRadius="4" Margin="12,4,0,4" MinWidth="200">
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Detay Alanı -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">

                <!-- Hata Kodu ve Ciddiyet -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Hata Kodu" Style="{StaticResource SectionTitle}"/>
                        <Border Background="#FFCDD2" Padding="6,2" CornerRadius="3" Margin="12,12,0,4">
                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                <Run Text="Ciddiyet: "/>
                                <Run Text="{Binding Severity}"/><Run Text="/5"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <Border Background="#FFF3E0" Padding="12" CornerRadius="4">
                        <TextBlock Text="{Binding ErrorCode}" FontSize="20" FontFamily="Consolas" FontWeight="Bold"/>
                    </Border>

                    <!-- Hata Adı -->
                    <TextBlock Text="Hata Adı" Style="{StaticResource SectionTitle}"/>
                    <Border Background="#E3F2FD" Padding="12" CornerRadius="4">
                        <TextBlock Text="{Binding ErrorName}" FontSize="16" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Açıklama -->
                    <TextBlock Text="Açıklama" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,4"/>

                    <!-- Yaygın Nedenler -->
                    <TextBlock Text="Yaygın Nedenler" Style="{StaticResource SectionTitle}"/>
                    <Border Background="#FFF8E1" Padding="12" CornerRadius="4" Margin="0,0,0,8">
                        <TextBlock Text="{Binding CommonCauses}" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Çözüm Adımları -->
                    <TextBlock Text="Çözüm Adımları" Style="{StaticResource SectionTitle}"/>
                    <Border Background="#E8F5E9" Padding="12" CornerRadius="4">
                        <TextBlock Text="{Binding SolutionSteps}" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Kesin Çözüm -->
                    <TextBlock Text="⭐ Kesin Çözüm" Style="{StaticResource SectionTitle}"/>
                    <Border Background="#E8F5E9" Padding="12" CornerRadius="4" Margin="0,0,0,8">
                        <TextBlock Text="{Binding KesinCozum}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    </Border>

                    <!-- İlgili Linkler -->
                    <TextBlock Text="İlgili Bağlantılar" Style="{StaticResource SectionTitle}"
                               Visibility="{Binding HasRelatedKbUrls, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding RelatedKbUrls}" TextWrapping="Wrap" FontSize="12" Foreground="#1565C0"
                               Visibility="{Binding HasRelatedKbUrls, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Dosya Yolu -->
                    <TextBlock Text="Kaynak Dosya" Style="{StaticResource SectionTitle}"
                               Visibility="{Binding HasDumpFilePath, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding DumpFilePath}" FontSize="11" FontFamily="Consolas" Foreground="#888"
                               Visibility="{Binding HasDumpFilePath, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Çözüldü Onayı -->
                    <Border Background="#E8F5E9" Padding="12" CornerRadius="4" Margin="0,12,0,0"
                            Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="✅ Bu hata çözüldü olarak işaretlendi." FontWeight="SemiBold" Foreground="#2E7D32"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading -->
        <Border Grid.Row="3" Background="#F5F5F5" Padding="8" CornerRadius="4"
                Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Minidump taranıyor..." 
                       HorizontalAlignment="Center" Foreground="#666"/>
        </Border>

        <!-- Geçmiş Analizler -->
        <Border Grid.Row="4" Background="#FAFAFA" CornerRadius="6" Padding="8" Margin="0,8,0,4"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Geçmiş Başlık -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="📋 Geçmiş Analizler" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="🔄 Yenile"
                            Command="{Binding RefreshHistoryListCommand}"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="11" Padding="8,4" Margin="12,0,0,0"/>
                </StackPanel>

                <!-- Geçmiş Listesi (DataGrid) -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding HistoryItems}"
                          SelectedItem="{Binding SelectedHistoryItem}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          FontSize="12"
                          BorderThickness="0"
                          Background="Transparent"
                          AlternatingRowBackground="#F0F0F0">

                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick"
                                      Command="{Binding ShowHistoryDetailCommand}"/>
                    </DataGrid.InputBindings>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding DisplayTime}" Width="140"/>
                        <DataGridTextColumn Header="Hata Kodu" Binding="{Binding ErrorCode}" Width="110"
                                            FontFamily="Consolas" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Hata Adı" Binding="{Binding ErrorName}" Width="*"/>
                        <DataGridTextColumn Header="Durum" Binding="{Binding ResolvedIcon}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Alt Bilgi -->
        <TextBlock Grid.Row="5" Text="v0.3.0 — BSOD Doctor — Watch Service" 
                   FontSize="11" Foreground="#999" HorizontalAlignment="Right"/>
    </Grid>
</Window>
