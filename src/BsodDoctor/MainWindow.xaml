<Window x:Class="BsodDoctor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BsodDoctor.ViewModels"
        xmlns:local="clr-namespace:BsodDoctor"
        mc:Ignorable="d"
        Title="BSOD Doctor" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#106EBE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="BSOD Doctor" FontSize="28" FontWeight="Bold" Foreground="#D32F2F"/>
            <TextBlock Text="Mavi Ekran Hatalarına Hızlı Çözüm" FontSize="14" Foreground="#666666"/>
            <Separator Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Aksiyon Butonları -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="🔍 Minidump Tara" 
                    Command="{Binding ScanDumpsCommand}"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding IsAnalyzing, Converter={StaticResource BoolInverter}}"/>
            <Button Content="📋 Event Log Tara"
                    Command="{Binding ScanEventLogCommand}"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding IsAnalyzing, Converter={StaticResource BoolInverter}}"/>
            <Border Background="#FFF3E0" Padding="12,8" CornerRadius="4" Margin="12,4,0,4">
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
            </Border>
        </StackPanel>

        <!-- Sonuç Alanı -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                <!-- Hata Kodu -->
                <StackPanel>
                    <TextBlock Text="Hata Kodu" Style="{StaticResource SectionTitle}"/>
                    <Border Background="#FFF3E0" Padding="12" CornerRadius="4">
                        <TextBlock Text="{Binding ErrorCode}" FontSize="18" FontFamily="Consolas" FontWeight="Bold"/>
                    </Border>

                    <!-- Hata Adı -->
                    <TextBlock Text="Hata Adı" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding ErrorName}" FontSize="14" Margin="0,0,0,8"/>

                    <!-- Açıklama -->
                    <TextBlock Text="Açıklama" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <!-- Çözüm Adımları -->
                    <TextBlock Text="Çözüm Adımları" Style="{StaticResource SectionTitle}"/>
                    <Border Background="#E8F5E9" Padding="12" CornerRadius="4">
                        <TextBlock Text="{Binding SolutionSteps}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading -->
        <Border Grid.Row="3" Background="#F5F5F5" Padding="8" CornerRadius="4"
                Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Analiz ediliyor, lütfen bekleyin..." 
                       HorizontalAlignment="Center" Foreground="#666"/>
        </Border>

        <!-- Alt Bilgi -->
        <TextBlock Grid.Row="3" Text="v0.1.0 — BSOD Doctor" 
                   FontSize="11" Foreground="#999" HorizontalAlignment="Right"/>
    </Grid>
</Window>
