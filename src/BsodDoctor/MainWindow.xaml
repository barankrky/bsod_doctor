<Window x:Class="BsodDoctor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:BsodDoctor.Models"
        Title="BSOD Doctor 🩺💻"
        Height="750" Width="1100"
        MinHeight="500" MinWidth="800"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- DataTemplate for error list items -->
        <DataTemplate x:Key="ErrorItemTemplate" DataType="models:BsodError">
            <Border Background="{StaticResource CardBrush}" 
                    CornerRadius="6" Padding="12,8" Margin="2,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Severity indicator bar -->
                    <Rectangle Grid.Column="0" 
                               Width="4" Height="40" 
                               RadiusX="2" RadiusY="2"
                               Margin="0,0,10,0"
                               Fill="{Binding SeverityColor}" />

                    <!-- Error info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" 
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Category, FallbackValue='Kategori yok'}" 
                                   FontSize="11" 
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Severity badge -->
                    <Border Grid.Column="2" 
                            Background="#333" CornerRadius="4" 
                            Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SeverityLabel}" 
                                   FontSize="11" Foreground="{StaticResource WarningBrush}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Analysis history item template -->
        <DataTemplate x:Key="HistoryItemTemplate" DataType="models:AnalysisResult">
            <Border Background="{StaticResource CardBrush}" 
                    CornerRadius="4" Padding="8,6" Margin="0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               Text="{Binding Timestamp, StringFormat={}{0:dd.MM HH:mm}}" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               FontSize="11" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Summary}" 
                               FontSize="12" />
                    <TextBlock Grid.Column="2" Text="{Binding ErrorCode}" 
                               FontFamily="Consolas" FontSize="11" 
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== HEADER / TOOLBAR ===== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" 
                Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="#3E3E42">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🩺" FontSize="26" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="BSOD Doctor" FontSize="20" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Mavi Ekran Teşhis ve Çözüm Aracı" FontSize="11" 
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Search Box -->
                <Border Grid.Column="1" Background="{StaticResource CardBrush}" 
                        CornerRadius="4" Margin="40,0,20,0" 
                        BorderThickness="1" BorderBrush="#3E3E42"
                        VerticalAlignment="Center" Height="32" MaxWidth="400">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" Margin="8,0,4,0" 
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" 
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontSize="13" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding SearchErrorsCommand}" Content="Ara" Margin="0,0,6,0" />
                    <Button Command="{Binding ScanDumpsCommand}"
                            Content="📂 Dump Tara" Margin="0,0,6,0"
                            Background="#2D2D30" BorderThickness="1" BorderBrush="#3E3E42" />
                    <Button Command="{Binding ReadEventLogCommand}"
                            Content="📋 Event Log Oku" Margin="0,0,6,0"
                            Background="#2D2D30" BorderThickness="1" BorderBrush="#3E3E42" />
                    <Button Command="{Binding LoadErrorsCommand}"
                            Content="🔄 Yenile"
                            Background="#2D2D30" BorderThickness="1" BorderBrush="#3E3E42" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Row="1" Margin="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Error List -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" 
                    CornerRadius="8" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Panel header -->
                    <Border Grid.Row="0" Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="#3E3E42">
                        <TextBlock Text="BSOD Hata Kodları" FontSize="14" FontWeight="SemiBold" />
                    </Border>

                    <!-- Error list -->
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding ErrorList}"
                             SelectedItem="{Binding SelectedError}"
                             ItemTemplate="{StaticResource ErrorItemTemplate}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent" />
                </Grid>
            </Border>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Column="1" Width="4" Margin="4,0"
                          Background="#3E3E42" ResizeBehavior="CurrentAndNext"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch" />

            <!-- RIGHT PANEL: Error Details & History -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8">

                    <!-- ===== Error Details Card ===== -->
                    <Border Background="{StaticResource SurfaceBrush}" 
                            CornerRadius="8" Padding="16" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Hata Detayı" FontSize="14" FontWeight="SemiBold" 
                                       Margin="0,0,0,12" />

                            <!-- Dynamic content based on selection -->
                            <ContentControl Content="{Binding SelectedError}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate DataType="models:BsodError">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Kod:" 
                                                           Foreground="{StaticResource TextSecondaryBrush}" Width="60" />
                                                <TextBlock Grid.Column="1" Text="{Binding ErrorCode}" 
                                                           FontFamily="Consolas" FontSize="16" FontWeight="Bold" />
                                            </Grid>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Ad:" 
                                                           Foreground="{StaticResource TextSecondaryBrush}" Width="60" />
                                                <TextBlock Grid.Column="1" Text="{Binding ErrorName}" FontSize="14" />
                                            </Grid>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Kategori:" 
                                                           Foreground="{StaticResource TextSecondaryBrush}" Width="60" />
                                                <Border Grid.Column="1" Background="#333" CornerRadius="3" Padding="6,2" 
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Category}" FontSize="12" />
                                                </Border>
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Ciddiyet:" 
                                                           Foreground="{StaticResource TextSecondaryBrush}" Width="60" />
                                                <TextBlock Grid.Column="1" Text="{Binding SeverityLabel}" 
                                                           Foreground="{Binding SeverityColor}" FontWeight="SemiBold" />
                                            </Grid>

                                            <TextBlock Text="Açıklama" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" 
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,0,0,12" />

                                            <TextBlock Text="Yaygın Nedenler" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding CommonCauses}" TextWrapping="Wrap" 
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,0,0,12" />

                                            <TextBlock Text="Çözüm Adımları" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <Border Background="{StaticResource CardBrush}" 
                                                    CornerRadius="6" Padding="12">
                                                <TextBlock Text="{Binding SolutionSteps}" TextWrapping="Wrap" 
                                                           Foreground="{StaticResource TextPrimaryBrush}" 
                                                           FontSize="12" LineHeight="18" />
                                            </Border>

                                            <TextBlock Text="Microsoft KB Linkleri" FontWeight="SemiBold" 
                                                       Margin="0,12,0,4" />
                                            <TextBlock Text="{Binding RelatedKbUrls}" TextWrapping="Wrap" 
                                                       Foreground="{StaticResource PrimaryBrush}" FontSize="12" />

                                            <!-- Mark as Resolved -->
                                            <Button Command="{Binding DataContext.MarkAsResolvedCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    Content="✅ Çözüldü Olarak İşaretle"
                                                    Background="{StaticResource SuccessBrush}"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0,16,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <!-- Placeholder when nothing selected -->
                            <TextBlock Text="👈 Sol panelden bir hata kodu seçin veya tarama başlatın"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontStyle="Italic" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <!-- ===== Analysis History Card ===== -->
                    <Border Background="{StaticResource SurfaceBrush}" 
                            CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Analiz Geçmişi" FontSize="14" FontWeight="SemiBold" 
                                       Margin="0,0,0,8" />

                            <ListBox ItemsSource="{Binding AnalysisHistory}"
                                     ItemTemplate="{StaticResource HistoryItemTemplate}"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" 
                Padding="12,6" BorderThickness="0,1,0,0" BorderBrush="#3E3E42">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="8" Height="8" 
                         Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"
                         VerticalAlignment="Center" />

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" 
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />

                <ProgressBar Grid.Column="2" 
                             IsIndeterminate="True"
                             Width="120" Height="4" 
                             Foreground="{StaticResource PrimaryBrush}" 
                             Background="#3E3E42" />
            </Grid>
        </Border>
    </Grid>
</Window>
