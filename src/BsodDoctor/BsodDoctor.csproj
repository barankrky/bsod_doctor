<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Sadece gerçek Windows build'lerinde WinRT API'lerini aktifleştir -->
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);REAL_WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <!-- Toast notification: NuGet restore + Windows-specific DLL reference -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" ExcludeAssets="compile" />
  </ItemGroup>

  <!-- Windows build'lerinde DesktopNotificationManagerCompat içeren DLL'i kullan -->
  <!-- net5.0-windows10.0.17763 hedefindeki DLL, DesktopNotificationManagerCompat tipini içerir -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Reference Include="Microsoft.Toolkit.Uwp.Notifications">
      <HintPath>$(NuGetPackageRoot)microsoft.toolkit.uwp.notifications\7.1.3\lib\net5.0-windows10.0.17763\Microsoft.Toolkit.Uwp.Notifications.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Seed data dosyasını build/publish çıktısına kopyala -->
  <ItemGroup>
    <Content Include="..\..\database\seed_data.json" Link="database\seed_data.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
